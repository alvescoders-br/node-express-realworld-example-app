{
  "name": "e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "api"
  ],
  "projectType": "application",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/playwright"
      ],
      "options": {
        "command": "npm run e2e:api"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "api-e2e": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/playwright"
      ],
      "options": {
        "command": "npm run e2e:api"
      }
    }
  }
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "tempDirName": "stryker-tmp",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.mutation.ts",
    "enableFindRelatedTests": false
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.spec.json",
  "mutate": [
    "src/app/routes/article/article.service.ts",
    "src/app/routes/article/bookmark.service.ts",
    "src/app/routes/article/comment.service.ts",
    "src/app/routes/article/favorite.service.ts",
    "src/app/routes/tag/tag.service.ts"
  ],
  "ignorePatterns": [
    ".stryker-tmp/**",
    "dist/**",
    "harness/**",
    "node_modules/**",
    "reports/**",
    "stryker-tmp/**",
    "tmp/**"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 95,
    "low": 80,
    "break": 95
  },
  "concurrency": 2
}

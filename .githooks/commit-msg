#!/bin/sh
# commit-msg hook — enforces the §7 discipline: every commit must reference a
# GitHub issue (e.g. "#12").  Merge / revert / fixup / squash commits are exempt.
#
# Activate once per clone:
#     git config core.hooksPath .githooks
#
# See .github/COMMIT_CONVENTION.md and docs/GUIA-DE-REFATORACAO.md §6/§7.

msg_file="$1"
first_line=$(head -n1 "$msg_file")

case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if grep -Eq '#[0-9]+' "$msg_file"; then
  exit 0
fi

echo "------------------------------------------------------------------" >&2
echo "✗ commit-msg: a mensagem precisa referenciar uma issue (ex.: '#12')." >&2
echo "  Regra §6/§7: 'issue antes de código; todo commit referencia #<id>'." >&2
echo "  Veja .github/COMMIT_CONVENTION.md." >&2
echo "------------------------------------------------------------------" >&2
exit 1

    "/api/users": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register",
        "description": "Creates a new user account and returns a JWT token. Auth none.",
        "operationId": "createUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user"],
                "properties": {
                  "user": {
                    "type": "object",
                    "required": ["email", "username", "password"],
                    "properties": {
                      "email": { "type": "string", "format": "email" },
                      "username": { "type": "string" },
                      "password": { "type": "string", "format": "password" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "422": {
            "description": "Validation error — blank fields or already-taken email/username.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" },
                "example": {
                  "errors": {
                    "email": ["has already been taken"],
                    "username": ["has already been taken"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "description": "Authenticates a user and returns a JWT token. Auth none.",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user"],
                "properties": {
                  "user": {
                    "type": "object",
                    "required": ["email", "password"],
                    "properties": {
                      "email": { "type": "string", "format": "email" },
                      "password": { "type": "string", "format": "password" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "403": {
            "description": "Invalid credentials. The error key is literally `\"email or password\"` (with space).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" },
                "example": {
                  "errors": {
                    "email or password": ["is invalid"]
                  }
                }
              }
            }
          },
          "429": {
            "description": "Login rate limit exceeded.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the login attempt may be retried.",
                "schema": { "type": "integer", "minimum": 0 }
              },
              "RateLimit-Limit": {
                "description": "Maximum login attempts allowed during the current rate-limit window.",
                "schema": { "type": "integer", "minimum": 1 }
              },
              "RateLimit-Remaining": {
                "description": "Remaining login attempts in the current rate-limit window.",
                "schema": { "type": "integer", "minimum": 0 }
              },
              "RateLimit-Reset": {
                "description": "Seconds until the login rate-limit window resets.",
                "schema": { "type": "integer", "minimum": 0 }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" },
                "example": {
                  "errors": { "login": ["rate limit exceeded"] }
                }
              }
            }
          },
          "422": {
            "description": "Validation error — blank email or password.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" },
                "example": {
                  "errors": { "email": ["can't be blank"] }
                }
              }
            }
          }
        }
      }
    },
    "/api/user": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current user",
        "description": "Returns the currently authenticated user. Auth required.",
        "operationId": "getCurrentUser",
        "security": [{ "TokenAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthorizedErrorResponse" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Auth"],
        "summary": "Update current user",
        "description": "Updates the currently authenticated user. Auth required. All fields are optional; only provided fields are updated.",
        "operationId": "updateUser",
        "security": [{ "TokenAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user"],
                "properties": {
                  "user": {
                    "type": "object",
                    "properties": {
                      "email": { "type": "string", "format": "email" },
                      "username": { "type": "string" },
                      "password": { "type": "string", "format": "password" },
                      "image": { "type": "string", "nullable": true },
                      "bio": { "type": "string", "nullable": true }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthorizedErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    { "name": "Auth", "description": "User registration, login, and account management." },
    { "name": "Articles", "description": "CRUD operations for articles." },
    { "name": "Comments", "description": "Comments on articles." },
    { "name": "Favorites", "description": "Article favorites." },
    { "name": "Bookmarks", "description": "Personal article bookmarks." },
    { "name": "Profiles", "description": "User profiles and follow/unfollow." },
    { "name": "Tags", "description": "Article tags." }
  ]
}
